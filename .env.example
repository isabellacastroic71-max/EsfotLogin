# Supabase Configuration
# Obtén estos valores en: https://app.supabase.com/project/[project-id]/settings/api

# URL del proyecto Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clave anónima de Supabase (segura para el cliente)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Nota: Las variables con prefijo EXPO_PUBLIC_ se exponen al cliente
# NUNCA expongas EXPO_PUBLIC_SUPABASE_SERVICE_ROLE_KEY en el cliente
